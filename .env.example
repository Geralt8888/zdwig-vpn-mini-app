# URL Cloudflare Worker (worker.js), который выдаёт VPN-ключи.
# Пустое значение = демо-режим: ключ генерируется локально.
VITE_API_BASE_URL=

# Прямое подключение к FVPN — ТОЛЬКО для локальной отладки.
# Внимание: любые VITE_* переменные попадают в клиентский бандл.
# Для продакшена используйте Cloudflare Worker и секреты wrangler.
# VITE_FVPN_API_URL=
# VITE_FVPN_API_KEY=
